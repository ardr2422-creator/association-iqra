# Copiez ce fichier en `.env.local` puis remplissez les valeurs.
# Ne mettez jamais de vraies valeurs dans `.env.example`.

# --- Supabase : authentification ---------------------------------------------
# Projet Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Identifiant (UUID) du compte de la trésorière : Supabase > Authentication > Users.
# Seul ce compte peut entrer. Obligatoire en production.
AUTH_ALLOWED_USER_ID=

# --- Supabase : base de données (Prisma) -------------------------------------
# Projet Supabase > Connect > ORMs > Prisma
# DATABASE_URL : connexion « pooler » utilisée par l'application.
# DIRECT_URL   : connexion directe utilisée uniquement pour les migrations.
DATABASE_URL=
DIRECT_URL=

# Certificat racine de Supabase (public, ce n'est pas un secret) :
# Database > Settings > SSL Configuration > Download certificate, puis collez
# ici tout le contenu du fichier. La liaison avec la base est toujours chiffrée
# et le serveur toujours vérifié ; ce certificat est nécessaire si celui de la
# base n'est pas reconnu par les autorités habituelles (connexion refusée sinon).
DATABASE_CA_CERT=

# --- Rappels de chèques par email (facultatif) --------------------------------
# Chaque matin, Vercel appelle /api/cron/rappels avec ce secret ; s'il y a des
# chèques à encaisser dans les 3 jours ou en retard, un email part à l'adresse
# indiquée dans les Paramètres. Sans ces deux valeurs, aucun email n'est envoyé.
# CRON_SECRET    : au moins 16 caractères aléatoires (ex. `openssl rand -hex 32`).
# RESEND_API_KEY : clé d'envoi créée sur resend.com (API Keys).
# REMINDER_FROM  : expéditeur, une fois votre domaine vérifié chez Resend
#                  (ex. "Iqra Compta <rappels@votre-domaine.fr>"). Par défaut,
#                  l'adresse de test de Resend, qui n'écrit qu'à votre propre compte.
CRON_SECRET=
RESEND_API_KEY=
REMINDER_FROM=

# --- Développement sans Supabase (facultatif) --------------------------------
# Avec AUTH_DEMO_MODE=1 et SANS les deux variables NEXT_PUBLIC_SUPABASE_*,
# l'application s'ouvre sans connexion. Ignoré en production.
# AUTH_DEMO_MODE=1
